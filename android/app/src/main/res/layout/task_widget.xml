<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="7dp" android:paddingBottom="10dp" android:background="@drawable/widget_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/task_widget_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="Tareas" android:textColor="@color/widget_on_surface" android:textStyle="bold" android:textSize="18sp"/>
        <ImageView android:id="@+id/task_widget_add" android:layout_width="35dp" android:layout_height="35dp" android:contentDescription="Nueva tarea" android:padding="7dp" android:src="@drawable/ic_widget_add" android:tint="@color/widget_primary"/>
    </LinearLayout>
    <ListView android:id="@+id/task_widget_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="0dp"/>
</LinearLayout>
